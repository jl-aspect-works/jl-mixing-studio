{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JL Mixing Studio",
  "version": "2.2.0-rc.1",
  "identifier": "com.jlaudio.jlmixingstudio",
  "mainBinaryName": "jl-mixing-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JL Mixing Studio",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "Copyright © 2026 JL Aspect Works contributors",
    "homepage": "https://github.com/jl-aspect-works/jl-mixing-studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "longDescription": "A studio-aware desktop workflow for JL Mixing Automation.",
    "publisher": "JL Aspect Works",
    "shortDescription": "Desktop workflow for JL Mixing Automation"
  }
}
